# Copy this file to `.env` and fill in real values. Do NOT commit `.env`.
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGO_DB=CoffeeShop
MONGO_COLLECTION=coffee

# Comma-separated allowed origins, e.g. https://app.example.com,http://localhost:19006
CORS_ORIGINS=*

# Passcode required to add/edit/delete products via /admin. Use a long random
# value. If left unset, all product write endpoints are refused.
ADMIN_TOKEN=change-me-to-a-long-random-string

FLASK_DEBUG=false
PORT=5000
